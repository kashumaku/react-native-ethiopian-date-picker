{
  "name": "react-native-ethiopian-date-picker",
  "version": "0.2.0",
  "description": "Production-ready Ethiopian calendar date picker for React Native and Expo",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react-native",
    "expo",
    "ethiopian-calendar",
    "ethiopian-date-picker",
    "amharic-calendar",
    "date-picker",
    "ethiopia",
    "calendar",
    "pagumen",
    "meskerem"
  ],
  "author": "kassahun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kashumaku/react-native-ethiopian-date-picker.git"
  },
  "bugs": {
    "url": "https://github.com/kashumaku/react-native-ethiopian-date-picker/issues"
  },
  "homepage": "https://github.com/kashumaku/react-native-ethiopian-date-picker#readme",
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "clean": "rimraf dist",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.20.0",
    "expo": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-test-renderer": "^19.2.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.2.5",
    "tsup": "^8.5.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0"
  }
}
